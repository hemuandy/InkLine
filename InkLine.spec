    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name="InkLine",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon="inkline/assets/icon.ico",
    version="scripts/version_info.txt",
)
